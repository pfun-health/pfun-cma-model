{
  "name": "pfun-time2move",
  "private": true,
  "type": "module",
  "description": "PFun time2move: realtime movement-to-glucose demo on Cloudflare Workers, driven by the PFun CMA engine (WebAssembly).",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "engine": "node scripts/sync-engine.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/dev.ts",
    "dev:worker": "wrangler dev",
    "deploy": "npm run engine && npm run build && wrangler deploy",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "wrangler": "^4.151.1"
  }
}
