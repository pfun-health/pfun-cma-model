<!-- base.html.jinja2 -->
<!DOCTYPE html>
<html lang="en">

{# <!-- macro imports --> #}
{% import 'macros/common.html.jinja2' as common %}
{% import 'macros/survey_modal.html.jinja2' as survey_modal %}
{% import 'macros/google_tags.html.jinja2' as google_tags %}

<head>
  {% block head %}
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {% block title %}{% endblock %}
    ~ PFun Digital Health</title>

  <!-- bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous" />

  <!-- Jquery CSS stylesheets -->
  <link rel="stylesheet" href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" />

  <!-- Google Tags script -->
  {{ google_tags.google_tags_head_script() }}

  {% endblock %}
</head>

<body>
  {% block body %}
  <!-- Google Tags body script -->
  {{ google_tags.google_tags_body() }}

  <!-- insert survey modal html via macro -->
  <div class="container-fluid">
  {{ survey_modal.survey_modal_html() }}
  </div>

  <header>
    {% block navheader %}
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
      <div class="container-fluid">
        <a class="navbar-brand" href="/"><img src="/favicon.ico" width="50px"></a>
        <button class="navbar-toggler ms-auto" type="button" data-bs-toggle="collapse" data-bs-target="#navbarBase"
          aria-controls="navbarBase" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarBase">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" aria-current="page" href="/pitch" target="_new" title="About PFun">About</a>
            </li>
            <!-- Notebooks dropdown -->
            <li id="notebooks-dropdown" class="nav-item dropdown">
              <a class="nav-link nav-link-secondary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Notebooks
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item"
                    href="{{ url_for('static', path='notebooks/cma-model-modular-demos.html') }}"
                    target="_self">Modular CMA Model Demo</a>
                </li>
                <li>
                  <a class="dropdown-item"
                    href="{{ url_for('static', path='notebooks/visualize-generated-scenarios.html') }}"
                    target="_self">Visualize Generated Scenarios</a>
                </li>
              </ul>
            </li>
            <!-- Demos Dropdown -->
            <li id="demos-dropdown" class="nav-item dropdown nav-item-primary">
              <a class="nav-link nav-link-primary dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Demos
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/demo/canvas-wave" target="_self">(HTML5) Canvas Wave Demo</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/demo/webgl-demo" target="_self">(WebGL) Streaming Demo</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/demo/full-model-run" target="_self">(WebSockets) Full Model (c, m,
                    a)</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/demo/run-at-time" target="_self">(Chart.js) Run-at-Time Demo</a>
                </li>
              </ul>
            </li>
            <!-- API Documentation Dropdown -->
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                API Docs
              </a>
              <ul class="dropdown-menu">
                <li>
                  <a class="dropdown-item" href="/docs">Documentation (SwaggerUI)</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/redoc">Documentation (ReDoc)</a>
                </li>
                <li>
                  <a class="dropdown-item" href="/openapi.json">OpenAPI Schema</a>
                </li>
              </ul>
            </li>
          </ul>
          <!-- insert github star repo iframe via macro -->
          {{ common.github_star_embed() }}
        </div>
      </div>
    </nav>
    {% endblock %}
  </header>
  <div id="content">
    {% block content %}{% endblock %}
  </div>
  <footer>
    {% block footer %}
    <div class="container-fluid text-center mb-2">
      <div class="container-row mb-2 mt-2">
        {{ common.github_star_embed() }}
      </div>
      <span class="text-muted">
        <small>PFun Digital Health ~
          {{ year }}. All rights reserved.</small>
      </span>
    </div>
    <p>
      <small>{{ message }}</small>
    </p>
    {% endblock %}
  </footer>
  <!-- Scripts (inserted via macro) -->
  {{ common.jquery_script() }}
  {{ common.bootstrap_script() }}
  {{ survey_modal.survey_modal_script() }}
  {% endblock body %}
</body>

</html>